#!/bin/sh
# Restart dwm in place (same as $mod+Shift+r): SIGHUP makes dwm save its
# state, release the clients and re-exec itself, so a newly installed binary
# is picked up and windows keep their tags, layouts, order and focus.
pid=$(dwm-wmpid) || { echo "dwm-restart: no dwm on $DISPLAY" >&2; exit 1; }
kill -HUP "$pid"
