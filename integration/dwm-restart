#!/bin/sh
# $mod+Shift+r / $mod+Shift+c: restart dwm in place.
# dwm-session runs dwm in a loop, so the X clients and the autostart helpers
# stay alive.
# The focus outline moved into dwm; stop an external helper from an older
# install before the new binary takes over (comm is truncated to 15 chars).
pkill -x i3-focus-outlin 2>/dev/null || true
pkill -TERM -x dwm
